<?xml version="1.0" encoding="utf-8"?>
<!-- Data extraction rules that exclude the Room database for Android 12+ -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="database" path="streamnova_database.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="database" path="streamnova_database.db" />
    </device-transfer>
</data-extraction-rules>
