# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# TMDB_API_KEY: The Movie Database (TMDB) v3 API key.
# Optional. Leave it unset (or keep this placeholder) if you do not use TMDB:
# the app builds fine without it and the TMDB catalog stays empty.
# Get a free key at https://www.themoviedb.org/settings/api.
# Set it locally, never commit a real value:
#   - copy this file to .env and fill it in (already git-ignored), or
#   - add TMDB_API_KEY=<your key> to local.properties (also git-ignored), or
#   - export TMDB_API_KEY in the environment before running Gradle.
# A key embedded in the APK is extractable by anyone: this keeps it out of the repo.
TMDB_API_KEY=DEFAULT_TMDB_API_KEY

# SIMKL client ID from https://simkl.com/settings/developer/.
# Developer-side configuration: StreamNova never asks the user for this value, so it
# must be in place when the APK is built. Set it here (copy this file to .env), or add
# SIMKL_CLIENT_ID=<id> to local.properties, or export it before running Gradle.
# Resolution order for the value baked into the APK: environment variable, then
# local.properties, then this file. A blank or placeholder value is not a client ID:
# the build then prints a warning and the SIMKL panel can only answer that the feature
# is not available in that build (see simkl_client_id_report.md).
# A V2 client (client type 'TV, devices and command line') returns a QR whose code is
# already filled in on the verification page; other clients fall back to AUTH V1 PIN.
# The placeholder below is rejected by the app and means 'SIMKL not configured'.
SIMKL_CLIENT_ID=DEFAULT_SIMKL_CLIENT_ID




# GOOGLE_DRIVE_CLIENT_ID: OAuth client ID per i backup personali su Google Drive.
# Developer-side configuration: create an OAuth client in Google Cloud Console
# (https://console.cloud.google.com/apis/credentials) with application type
# "TVs and Limited Input devices" — the Device Authorization Grant flow used by
# StreamNova on Android TV (no browser and no Google Play Services required on the
# device). Enable the Google Drive API for the project. The app requests only the
# per-file scope https://www.googleapis.com/auth/drive.file plus an identity scope
# (openid + userinfo.email) used solely to show which account is connected.
# Set it here (copy this file to .env), or add GOOGLE_DRIVE_CLIENT_ID=<id> to
# local.properties, or export it before running Gradle. A blank or placeholder
# value means 'Google Drive not configured': the build prints a warning and the
# Drive options answer "Non disponibile in questa build di StreamNova".
GOOGLE_DRIVE_CLIENT_ID=DEFAULT_GOOGLE_DRIVE_CLIENT_ID

# GOOGLE_DRIVE_CLIENT_SECRET: required by Google on the device-flow token endpoints
# (poll and refresh) even for "TVs and Limited Input devices" clients — the device
# flow fails with "Missing required parameter: client_secret" without it. Copy it
# from the same Google Cloud OAuth client as GOOGLE_DRIVE_CLIENT_ID. For TV apps the
# secret ships inside the APK by design of the flow; keep it out of the repository
# (this file is git-ignored).
GOOGLE_DRIVE_CLIENT_SECRET=DEFAULT_GOOGLE_DRIVE_CLIENT_SECRET
