<?xml version="1.0" encoding="utf-8"?>
<!--
  Overlay del manifest SOLO per la variante DEBUG.

  Applica `network_security_config.xml` (cleartext verso 127.0.0.1) per consentire
  la riproduzione locale del bug OpenSubtitles sull'emulatore: il server di prova
  sull'host e' raggiunto via `adb reverse tcp:8099 tcp:8099`.

  La variante RELEASE non riceve questo overlay e mantiene il comportamento di
  produzione (cleartext vietato, nessun addon/test in chiaro).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:networkSecurityConfig" />
</manifest>
