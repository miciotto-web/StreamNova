<?xml version="1.0" encoding="utf-8"?>
<!--
  Livello foreground dell'icona adattiva.

  La dimensione intrinseca di un layer-list è quella dei drawable figli, non quella
  dichiarata sugli <item>: per questo il figlio è un asset le cui dimensioni in px sono
  già quelle della griglia adattiva (432 px in drawable-xxxhdpi = 108 dp esatti).
  Con un figlio 512 px in drawable/ (= mdpi) il livello dichiarava 512 dp, quasi 5x la
  griglia: ogni launcher che disegna l'icona adattiva ingrandiva l'arte e la ritagliava
  in un frammento (verificato sulla tile di Fire TV, che usa android:icon).

  Il logo dentro l'asset occupa 56 dp, dentro il cerchio da 66 dp della safe zone.
  Sfondo trasparente: il navy lo fornisce ic_launcher_background.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ic_launcher_art_108dp" />
</layer-list>
