<?xml version="1.0" encoding="utf-8"?>
<!--
  Livello principale: icona opaca (nessun canale alpha) con margini di sicurezza.
  La base a tinta piena garantisce che il foreground non introduca trasparenza.
  80dp = arte inquadrata nel safe zone adattivo (cerchio da 66dp).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/splash_background" />
        </shape>
    </item>
    <item
        android:width="80dp"
        android:height="80dp"
        android:gravity="center"
        android:drawable="@drawable/streamnova_launcher_icon" />
</layer-list>
